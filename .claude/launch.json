{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "worldshop-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "mock-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mock"
      ],
      "port": 8787
    },
    {
      "name": "client-on-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_API_BASE_URL": "http://localhost:8787/api/v1"
      }
    }
  ]
}
