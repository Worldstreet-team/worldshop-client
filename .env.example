# Copy to .env.local for local development:  cp .env.example .env.local
# Vite only exposes variables prefixed with VITE_ — and every one of them is
# bundled into the client JS, so never put a secret here.

# ─── API ────────────────────────────────────────────────────────
# Production: https://shop-api.worldstreetgold.com/api/v1
# Local mock (npm run mock): http://localhost:8787/api/v1
VITE_API_BASE_URL=http://localhost:8787/api/v1

# ─── Clerk (required — app throws at boot without it) ───────────
# src/main.tsx hard-fails when this is missing. Publishable keys are public.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ─── External auth service (worldstreetgold.com identity hub) ───
VITE_AUTH_SERVICE_URL=https://api.worldstreetgold.com
VITE_LOGIN_URL=https://worldstreetgold.com/login
VITE_REGISTER_URL=https://worldstreetgold.com/register

# ─── Voice agent (optional) ─────────────────────────────────────
# Powers the VoiceButton via the OpenAI realtime API. Leave blank to disable —
# anything set here ships to the browser in plain text.
VITE_OPENAI_API_KEY=

# ─── App ────────────────────────────────────────────────────────
VITE_APP_NAME=WorldShop
VITE_APP_VERSION=1.0.0

# ─── Feature flags ──────────────────────────────────────────────
VITE_ENABLE_GUEST_CHECKOUT=true
VITE_ENABLE_WISHLIST=true

# ─── Pagination ─────────────────────────────────────────────────
VITE_DEFAULT_PAGE_SIZE=12

# ─── Image placeholders ─────────────────────────────────────────
VITE_PLACEHOLDER_IMAGE=/images/placeholder-product.png
